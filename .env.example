# Copy this file to ".env" and paste your key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Any model id from https://openrouter.ai/models (ids ending in ":free" cost nothing).
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Tried in order when the main model is busy (free models often are). Comma-separated.
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free
